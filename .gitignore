/node_modules
/vendor
/desktop-mode.zip
/dist/
/tests/phpunit/.phpunit.result.cache

# Vite build output under assets/js/ — regenerate locally with `npm run
# build`. Adding a new bundle in vite.config.js does not require updating
# this list. Hand-written JS files that should stay tracked are explicitly
# re-included below.
/assets/js/*.js
!/assets/js/admin-bar.js
!/assets/js/media-library-enhanced.js

.DS_Store

# Default output file of macOS/BSD `script(1)` — a terminal session
# recorder. Easy to commit by accident with `git add .`.
/typescript

# Playwright CLI
.playwright-cli/

# Phpactor's per-project config — Zed's PHP language server re-generates
# this on demand from sensible defaults, so tracking it just creates churn.
/.phpactor.json
