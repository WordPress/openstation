/node_modules
/vendor
/openstation.zip
/desktop-mode.zip
# Version-stamped release artifacts. `bin/package.sh` takes the output
# name as an argument, so a hand-built beta lands as e.g.
# `openstation-1.1.4-beta3.zip` and slipped past the two exact names
# above — a multi-megabyte binary sitting in `git status` waiting to be
# caught by an `git add -A`.
/openstation-*.zip
/desktop-mode-*.zip
/dist/
/tests/phpunit/.phpunit.result.cache
/.scratch/

# Vite build output under assets/js/ — regenerate locally with `npm run
# build`. Adding a new bundle in vite.config.js does not require updating
# this list. Hand-written JS files that should stay tracked are explicitly
# re-included below.
/assets/js/*.js
!/assets/js/admin-bar.js
!/assets/js/media-library-enhanced.js

# App Framework client views — `apps/<dir>/<name>.os.ts` builds to
# `assets/js/apps/<name>[.min].js`. Its own line because the pattern
# above only matches the top level of assets/js/.
/assets/js/apps/

# Vite bundle-visualizer reports (`${fileBase}.report.html`) — dev-only.
/assets/js/*.report.html

# Local wp-env overrides — per-checkout ports so several worktree
# instances can run in parallel. See docs/DEVELOPMENT.md.
/.wp-env.override.json
/.wp-env.tests.override.json

.DS_Store

# Default output file of macOS/BSD `script(1)` — a terminal session
# recorder. Easy to commit by accident with `git add .`.
/typescript

# Playwright CLI
.playwright-cli/

# Phpactor's per-project config — Zed's PHP language server re-generates
# this on demand from sensible defaults, so tracking it just creates churn.
/.phpactor.json

# `.claude/` is gitignored in the user's global gitignore. Re-include
# `skills/`, the project skill library Claude Code loads, as REGULAR
# tracked files. Everything else under `.claude/` (local settings,
# transient state) stays ignored.
#
# Never make anything under `.claude/` a symlink that points outside it.
# The `@claude` workflow (`.github/workflows/claude.yml`) treats `.claude/`
# as trusted configuration: on a pull request it deletes the checked-out
# copy and restores the directory from the base branch. A link to a path
# outside `.claude/` (an earlier layout kept the skills in `.agents/skills/`
# and linked to them from here) is restored as a link — its TARGET is not —
# so it resolves straight into the pull request's files, and a public fork
# gets to author a "trusted" project skill. `tests/vitest/claude-workflow-
# hardening.test.ts` pins this.
!/.claude/
/.claude/*
!/.claude/skills
# The software factory's agents (see AGENTS.md), regular files like the skills.
!/.claude/agents

# Software factory runtime state: job files, logs, per-job locks.
/factory/jobs/
