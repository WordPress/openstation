<?xml version="1.0"?>
<ruleset name="OpenStation">
	<description>Coding standards for the OpenStation plugin.</description>

	<!--
		Files this ruleset applies to. Extensions live in this monorepo
		for development convenience but ship as separate WordPress
		plugins; they're scanned independently against their own ruleset
		and excluded here so their text-domains and prefixes don't trip
		the parent-plugin scan.
	-->
	<file>.</file>
	<exclude-pattern>/extensions/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/dist/</exclude-pattern>
	<exclude-pattern>/assets/vendor/</exclude-pattern>
	<exclude-pattern>/tests/</exclude-pattern>

	<!-- Inherit the WordPress plugin standard. -->
	<rule ref="WordPress"/>

	<!--
		Custom prefix allowlist.

		The Plugin Check derives the canonical prefix from the plugin
		slug, which stays `desktop-mode` — that is the WordPress.org
		directory and the plugin's update path, so it cannot change.
		The code is prefixed for the brand instead, hence the explicit
		list: `open_station_*` / `OPEN_STATION_*` for the plugin itself,
		plus the short `osc` / `osm` namespaces the bundled phpMyAdmin
		and cron-manager extensions use in their prebuilt bundles.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="open_station"/>
				<element value="OPEN_STATION"/>
				<element value="openstation"/>
				<element value="osc"/>
				<element value="osm"/>
			</property>
		</properties>
	</rule>

	<!--
		Text domain consistency. Stays `desktop-mode`: WordPress.org
		delivers language packs keyed on the directory slug, so the
		domain has to keep matching it even though the brand changed.
	-->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="desktop-mode"/>
			</property>
		</properties>
	</rule>

	<!-- PHP / WP version targets — match plugin headers. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
