{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": [ "ES2020", "DOM", "DOM.Iterable" ],
		"types": [ "vitest/globals" ]
	},
	"include": [ "src/**/*.ts", "tests/vitest/**/*.ts", "vite.config.ts", "vitest.config.ts" ]
}
