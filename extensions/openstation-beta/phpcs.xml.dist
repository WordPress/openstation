<?xml version="1.0"?>
<ruleset name="OpenStation — OpenStation Beta">
	<description>Coding standards for the OpenStation Beta companion plugin.</description>

	<file>openstation-beta.php</file>
	<file>includes</file>

	<rule ref="WordPress"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="openstation_beta"/>
				<element value="OPENSTATION_BETA"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="openstation-beta"/>
			</property>
		</properties>
	</rule>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
