{
	"name": "@openstation/types",
	"version": "1.1.4",
	"private": true,
	"description": "TypeScript types and ambient globals for plugins building on top of WordPress OpenStation (`wp.os.*`).",
	"license": "GPL-2.0-or-later",
	"types": "src/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.d.ts"
		},
		"./global": {
			"types": "./src/global.d.ts"
		}
	},
	"files": [
		"src/**/*.d.ts",
		"README.md"
	],
	"keywords": [
		"wordpress",
		"openstation",
		"types"
	]
}
