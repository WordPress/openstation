{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/openstation/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "siteOptions": {
    "blogname": "OpenStation"
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/WordPress/openstation/releases/latest/download/openstation.zip"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
