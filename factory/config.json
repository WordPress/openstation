{
  "concurrency": 1,
  "max_rounds": 3,
  "base_branch": "trunk",
  "merge_method": "squash",
  "auto_merge": false,
  "teardown": ["bash", "-c", "npx wp-env destroy --force; npx wp-env destroy --force --config=.wp-env.tests.json"],
  "ci_timeout_minutes": 45,
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low":    { "builder": "sonnet", "code": "haiku" },
    "medium": { "builder": "sonnet", "code": "sonnet" },
    "high":   { "builder": "opus",   "code": "sonnet" }
  },
  "surface_reviewers": {
    "ui": { "ux": "sonnet", "ui": "haiku" },
    "security": { "security": "opus" }
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    ".claude/agents/*",
    ".claude/skills/factory/*",
    "phpcs.xml.dist",
    "tests/phpunit/phpunit.xml.dist",
    ".wp-env.tests.json",
    ".eslintrc.cjs",
    "vitest.config.ts",
    "assets/desktop-themes/legacy/theme.json",
    "tests/vitest/brand-palette.test.ts",
    "tests/vitest/accent-reach.test.ts",
    "tests/vitest/holo-layer.test.ts",
    "tests/vitest/component-token-reachability.test.ts",
    "tests/vitest/css-template-hygiene.test.ts",
    "tests/vitest/claude-workflow-hardening.test.ts",
    "tests/vitest/work-area.test.ts",
    "tests/vitest/mio-brand-fidelity.test.ts",
    "tests/phpunit/tests/aiNativeSearch.php",
    "tests/phpunit/tests/agentsAbilities.php",
    "tests/phpunit/tests/myWordpressCommentStats.php",
    "tests/phpunit/tests/myWordpressTermStats.php",
    "tests/phpunit/tests/desktopThemesLegacy.php"
  ],
  "ports": { "base": 8900, "step": 10 },
  "prices_usd_per_mtok": {
    "claude-fable-5-1":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
